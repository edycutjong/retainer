# When using `yarn infra:up`, credentials come from the repo-root `.env` instead.
# This file is for running the facilitator standalone: `cd facilitator && npm start`.

# Port the facilitator listens on.
PORT=4020

# CAIP-2 network this facilitator settles on.
X402_NETWORK=hedera:testnet

# Fee-payer account (ECDSA) + private key. The facilitator uses these at POST /settle to
# co-sign the buyer's partially signed TransferTransaction, pay Hedera network fees,
# and broadcast it. HashPack signs only the buyer side; it cannot complete settlement alone.
# Use a dedicated funded testnet account — not your deployer or seller wallet.
FACILITATOR_ACCOUNT_ID=0.0.xxxxxx
FACILITATOR_PRIVATE_KEY=

# Optional: custom consensus node / mirror endpoint for private Hedera networks.
# HEDERA_NODE_URL=
