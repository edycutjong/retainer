{
  "name": "retainer",
  "version": "1.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/hardhat",
      "packages/nextjs"
    ]
  },
  "scripts": {
    "audit": "yarn npm audit --recursive --severity high",
    "check-types": "yarn hardhat:check-types && yarn next:check-types",
    "ci": "yarn hardhat:compile && yarn test && yarn lint && yarn check-types",
    "e2e": "yarn next:build && playwright test",
    "e2e:ui": "yarn next:build && playwright test --ui",
    "format": "yarn next:format && yarn hardhat:format",
    "hardhat:account": "yarn workspace @retainer/hardhat account",
    "hardhat:account:generate": "yarn workspace @retainer/hardhat account:generate",
    "hardhat:account:import": "yarn workspace @retainer/hardhat account:import",
    "hardhat:account:reveal-pk": "yarn workspace @retainer/hardhat account:reveal-pk",
    "hardhat:chain": "yarn workspace @retainer/hardhat chain",
    "hardhat:check-types": "yarn workspace @retainer/hardhat check-types",
    "hardhat:clean": "yarn workspace @retainer/hardhat clean",
    "hardhat:compile": "yarn workspace @retainer/hardhat compile",
    "hardhat:deploy": "yarn workspace @retainer/hardhat deploy",
    "hardhat:flatten": "yarn workspace @retainer/hardhat flatten",
    "hardhat:fork": "yarn workspace @retainer/hardhat fork",
    "hardhat:format": "yarn workspace @retainer/hardhat format",
    "hardhat:lint": "yarn workspace @retainer/hardhat lint",
    "hardhat:lint-staged": "yarn workspace @retainer/hardhat lint-staged",
    "hardhat:test": "yarn workspace @retainer/hardhat test",
    "hardhat:verify": "yarn workspace @retainer/hardhat verify",
    "hardhat:verify:mainnet": "yarn workspace @retainer/hardhat verify:mainnet",
    "hardhat:verify:testnet": "yarn workspace @retainer/hardhat verify:testnet",
    "lighthouse": "lhci autorun",
    "lint": "yarn next:lint && yarn hardhat:lint",
    "lint-staged": "lint-staged",
    "next:build": "yarn workspace @retainer/nextjs build",
    "next:check-types": "yarn workspace @retainer/nextjs check-types",
    "next:dev": "yarn workspace @retainer/nextjs dev",
    "next:format": "yarn workspace @retainer/nextjs format",
    "next:lint": "yarn workspace @retainer/nextjs lint",
    "next:serve": "yarn workspace @retainer/nextjs serve",
    "next:start": "yarn workspace @retainer/nextjs start",
    "next:test": "yarn workspace @retainer/nextjs test",
    "postinstall": "husky",
    "precommit": "lint-staged",
    "release": "node scripts/release.mjs auto",
    "release:major": "node scripts/release.mjs major",
    "release:minor": "node scripts/release.mjs minor",
    "release:patch": "node scripts/release.mjs patch",
    "release:next": "node scripts/next-version.mjs --explain",
    "security-scan": "yarn audit || true",
    "test": "yarn hardhat:test && yarn next:test"
  },
  "packageManager": "yarn@3.2.3",
  "devDependencies": {
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.55.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "engines": {
    "node": ">=20.18.3"
  },
  "resolutions": {
    "axios@^0.21.1": "0.33.0",
    "undici@^5.14.0": "6.28.0",
    "protobufjs@7.5.4": "7.6.6",
    "elliptic@6.5.4": "6.6.1",
    "postcss@8.4.31": "8.5.28",
    "ws@7.4.6": "7.5.13",
    "ws@8.17.1": "8.21.3",
    "ws@8.18.0": "8.21.3",
    "ws@8.18.3": "8.21.3",
    "ws@8.20.1": "8.21.3"
  }
}
