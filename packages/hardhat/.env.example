# Hedera JSON-RPC endpoint (testnet default, change for mainnet).
# Get from: https://swirldslabs.com/hashio/ — the public endpoint below needs no account.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# Don't fill this in by hand. It is written for you, encrypted, by:
#   yarn hardhat:account:generate   (new account)
#   yarn hardhat:account:import     (existing ECDSA key)
# The account must be ECDSA and funded from https://portal.hedera.com/ before you deploy.
# NEVER commit a decrypted key. Real credentials live in ~/.config/retainer/.
DEPLOYER_PRIVATE_KEY_ENCRYPTED=

# --- Mirror node (read-only REST; used to resolve 0.0.x contract ids) ---
# Public endpoints are the defaults and need no account. Override only for a private mirror.
# HEDERA_MIRROR_TESTNET_URL=https://testnet.mirrornode.hedera.com
# HEDERA_MIRROR_MAINNET_URL=https://mainnet.mirrornode.hedera.com

# --- Deploy-time terms for RetainerAccess (read by deploy/01_deploy_retainer_access.ts) ---
# These are baked into the contract at deployment; changing them later needs a redeploy.

# Length of one access period, in seconds. Default 3600 (1 hour).
# The demo uses a short window (e.g. 90) so a renewal can be watched happening live.
# RETAINER_PERIOD_SECONDS=3600

# Metered calls one paid period allows. Default 25.
# RETAINER_CALLS_PER_PERIOD=25

# HBAR placed in the contract's gas reserve at deploy, as a decimal string. Default "8".
# The contract pays the network for its OWN scheduled renewals out of this pot, so an empty
# reserve means renewals stop firing. One re-arming renewal costs ~1.55 HBAR — see
# docs/gas-economics.md. Keep headroom: a scheduled renewal that finds the pots within a
# couple of HBAR of the balance reverts with Insolvent().
# RETAINER_RESERVE_HBAR=8

# --- Local chain ---
# Opt in to forking live Hedera for the local node (set by `yarn hardhat:fork`).
# Unit tests do not need it: the contract's HSS calls are covered by MockScheduleService.
# HEDERA_FORKING=false
