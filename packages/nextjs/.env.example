# --- Wallet / RPC (browser) ---

# Optional. A public scaffold project id is used when this is blank, which is fine for local
# work; set your own before sharing a deployment.
# Get from: https://dashboard.reown.com (formerly WalletConnect Cloud) -> Projects -> Project ID
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Optional RPC overrides for the browser. Blank falls back to the public Hashio endpoints.
# Get from: https://swirldslabs.com/hashio/ , or any Hedera JSON-RPC relay you operate.
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# --- x402 ---

# RPC endpoint the resource server uses to read RetainerAccess.
# Defaults to the public testnet RPC if unset.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# x402 facilitator. Hosted Blocky402 testnet — settlement must go through it.
# No API key or account required; it supplies its own fee payer.
FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
# Must match X402_NETWORK; used by the browser x402 client (HashPack).
NEXT_PUBLIC_X402_NETWORK=hedera:testnet

# --- Retainer ---
# Where subscription payments go: the seller's Hedera account id (0.0.x). Without it the gate
# cannot build a challenge and answers 500 rather than serving anything — it fails closed.
# Get from: https://portal.hedera.com/ -> your testnet account id, or the account you deployed
# RetainerAccess from (it is the contract's `beneficiary`).
RETAINER_PAY_TO=
# Price of one access period, in tinybar (1 HBAR = 100_000_000).
RETAINER_PRICE_TINYBAR=100000000

# How many periods one x402 payment buys. The first is charged on subscribe; the rest are
# charged by renewals the network executes unattended.
RETAINER_PERIODS_PER_PURCHASE=3

# ECDSA key of the seller account that forwards settled x402 payments into RetainerAccess.
# Without it the 402 still settles, but no subscription is opened.
# MUST be ECDSA — x402 on Hedera does not work with an ED25519 key.
# Get from: https://portal.hedera.com/ (create an ECDSA testnet account), or
#   `yarn hardhat:account:reveal-pk` for the account you deployed with.
# NEVER commit a real value. Keep the real one in ~/.config/retainer/hedera.env.
RETAINER_SERVER_KEY=
# Deployed RetainerAccess. Normally resolved from contracts/deployedContracts.ts after
# `yarn hardhat:deploy --network hederaTestnet`; set to override.
# RETAINER_ACCESS_ADDRESS=

# Browser-visible form of the address above. Server code prefers RETAINER_ACCESS_ADDRESS and
# falls back to this; set it only if a client component must know the address directly.
# NEXT_PUBLIC_RETAINER_ACCESS_ADDRESS=

# --- HCS payment audit trail (optional; additive) ---
# Hedera Consensus Service topic the resource server publishes settlement events to. Leave it
# blank and the writer is off: the payment path behaves identically, it just keeps no public
# record. Nothing on the paid path ever waits for, or fails because of, an HCS write.
# The live topic for this deployment is 0.0.10440194 — immutable (no admin key), and only the
# seller's account may append to it.
#   https://hashscan.io/testnet/topic/0.0.10440194
# Create your own with: yarn workspace @retainer/nextjs hcs:create-topic
# HCS_AUDIT_TOPIC_ID=

# Who signs the topic submissions. Defaults to RETAINER_PAY_TO / RETAINER_SERVER_KEY — the
# seller account that already receives the payment and forwards it on-chain — so enabling the
# trail is normally one variable and not a second key to manage. Set these only to write the
# trail from a different account.
# HCS_AUDIT_OPERATOR_ID=
# HCS_AUDIT_OPERATOR_KEY=

# --- Mirror node (read-only REST; powers the live chain feed on the landing page) ---
# Public endpoint is the default and needs no account.
# HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com

# --- Site metadata (Open Graph / social card) ---
# Absolute origin used for metadataBase and the social card URL. On Vercel this is derived
# from VERCEL_PROJECT_PRODUCTION_URL automatically; set it explicitly for a custom domain,
# or the card resolves against localhost and no platform can fetch it.
# NEXT_PUBLIC_SITE_URL=https://retainer.edycu.dev

# --- Demo agent (packages/nextjs/scripts/retainer-agent.ts) ---
# The script drives a real end-to-end paid request: 402 -> pay -> settle -> free.
# BASE_URL is the service it calls; PERIOD_SECONDS overrides the window length it expects,
# which is what makes an unattended renewal watchable inside a demo video.
#   BASE_URL=https://retainer.edycu.dev PERIOD_SECONDS=90 yarn tsx scripts/retainer-agent.ts
# BASE_URL=http://localhost:3000
# PERIOD_SECONDS=

# --- Set by CI, not by hand ---
# NEXT_PUBLIC_APP_VERSION is injected at build time from the root package.json version, so
# the footer stamp and the git tag cannot disagree. Leaving it unset yields the deliberately
# implausible "v0.0.0-dev", which makes a broken pipeline visible instead of quietly wrong.
# NEXT_PUBLIC_APP_VERSION=

# Escape hatch that makes `next build` ignore TypeScript and ESLint errors. Left unset on
# purpose — the Lint and Deploy pipelines are supposed to fail on those.
# NEXT_PUBLIC_IGNORE_BUILD_ERROR=false
