NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# --- x402 pay-per-use template ---

# RPC endpoint the resource server uses to read the FileRegistry contract.
# Defaults to the public testnet RPC if unset.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# FileRegistry address override. Normally resolved from the generated
# contracts/deployedContracts.ts after `yarn hardhat:deploy --network hederaTestnet`.
# FILE_REGISTRY_ADDRESS=
# Native Hedera contract id for HashPack `ContractExecuteTransaction` calls.
# Populated automatically on deploy; override only if needed.
# FILE_REGISTRY_HEDERA_CONTRACT_ID=0.0.9214560
# NEXT_PUBLIC_FILE_REGISTRY_HEDERA_CONTRACT_ID=

# Self-hosted x402 Hedera facilitator (see docker-compose.yml / facilitator/).
FACILITATOR_URL=http://localhost:4020
X402_NETWORK=hedera:testnet
# Must match X402_NETWORK; used by the browser x402 client (HashPack).
NEXT_PUBLIC_X402_NETWORK=hedera:testnet

# Local MinIO (S3-compatible) storage. Must match the values in the root `.env`
# used by docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=x402-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Required for MinIO (path-style URLs). Set to false only for AWS virtual-hosted buckets.
S3_FORCE_PATH_STYLE=true
