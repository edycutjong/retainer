NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
NEXT_PUBLIC_HEDERA_MAINNET_RPC_URL=
NEXT_PUBLIC_HEDERA_TESTNET_RPC_URL=

# --- x402 ---

# RPC endpoint the resource server uses to read RetainerAccess.
# Defaults to the public testnet RPC if unset.
HEDERA_RPC_URL=https://testnet.hashio.io/api

# x402 facilitator. Hosted Blocky402 testnet — settlement must go through it.
# No API key or account required; it supplies its own fee payer.
FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
# Must match X402_NETWORK; used by the browser x402 client (HashPack).
NEXT_PUBLIC_X402_NETWORK=hedera:testnet

# --- Retainer ---
# Where subscription payments go: the seller's Hedera account id (0.0.x).
RETAINER_PAY_TO=
# Price of one access period, in tinybar (1 HBAR = 100_000_000).
RETAINER_PRICE_TINYBAR=100000000

# How many periods one x402 payment buys. The first is charged on subscribe; the rest are
# charged by renewals the network executes unattended.
RETAINER_PERIODS_PER_PURCHASE=3

# ECDSA key of the seller account that forwards settled x402 payments into RetainerAccess.
# Without it the 402 still settles, but no subscription is opened.
RETAINER_SERVER_KEY=
# Deployed RetainerAccess. Normally resolved from contracts/deployedContracts.ts after
# `yarn hardhat:deploy --network hederaTestnet`; set to override.
# RETAINER_ACCESS_ADDRESS=
